   "source": [
    "import string\n",
    "\n",
    "text = input(\"Enter a string: \")\n",
    "\n",
    "allowed = string.ascii_letters + string.digits\n",
    "\n",
    "if all(char in allowed for char in text):\n",
    "    print(\"The string contains only a-z, A-Z, and 0-9.\")\n",
    "else:\n",
    "    print(\"The string contains invalid characters.\")\n"
   ]
